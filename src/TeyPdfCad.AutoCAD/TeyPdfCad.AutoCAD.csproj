<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TeyPdfCad.AutoCAD</RootNamespace>
    <AssemblyName>TeyPdfCad.AutoCAD</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AutoCADApiVersion>24.1.51000</AutoCADApiVersion>
    <AutoCADLocalApiDirectory Condition="'$(TEYPDFCAD_AUTOCAD_LOCAL_API)' != ''">$(TEYPDFCAD_AUTOCAD_LOCAL_API)</AutoCADLocalApiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TeyPdfCad.Core/TeyPdfCad.Core.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCADApiVersion)" ExcludeAssets="runtime" Condition="'$(AutoCADLocalApiDirectory)' == ''" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(AutoCADLocalApiDirectory)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeyPdfCad.AutoCAD.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(AutoCADLocalApiDirectory)' != ''">
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADLocalApiDirectory)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADLocalApiDirectory)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADLocalApiDirectory)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
